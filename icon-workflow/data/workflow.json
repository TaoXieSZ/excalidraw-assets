  "cards": [
    {
      "dot": "rose",
      "title": "这次实际走过的弯路",
      "items": [
        "v1 照文档比喻画成故事，被用户否定。",
        "v2 去掉人物与河流，改成技术符号。"
      ]
    },
    {
      "dot": "cyan",
      "title": "给普通文本模型的固定规则",
      "items": [
        "最多三个关键语义；固定图形词表。",
        "沿用已认可参考图，不重新探索画风。"
      ]
    },
    {
      "dot": "amber",
      "title": "能力边界",
      "items": [
        "文本模型准备规格，图像工具负责绘制。",
        "较弱模型尚未对照实测，不保证同等效果。"
      ]
    }
